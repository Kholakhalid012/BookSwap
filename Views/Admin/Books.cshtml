@model List<BookSwap.Models.Book>
@{
    ViewData["Title"] = "Manage Books";
}

<style>
    body {
        background: linear-gradient(to right, #fcf1cf, #fdccb7);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .table {
        background-color: #ffffffcc; 
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .table thead {
        background: linear-gradient(135deg, #f6d365, #fda085);
        color: #fff;
        font-weight: bold;
    }

    .table tbody tr:hover {
        background-color: #fff2e6;
        transform: scale(1.01);
        transition: 0.2s;
    }

    .table img {
        border-radius: 5px;
        object-fit: cover;
        box-shadow: 0 3px 6px rgba(0,0,0,0.2);
    }

    h2 {
        text-align: center;
        margin-top: 20px;
        margin-bottom: 20px;
        color: #06020c;
        font-weight: bold;
    }
</style>

<div class="table-responsive">
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Price</th>
                <th>Image</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Title</td>
                    <td>@b.Author</td>
                    <td>@b.Category</td>
                    <td>@b.Price.ToString("C")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(b.ImagePath))
                        {
                            <img src="@b.ImagePath" width="60" height="80" />
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="@Url.Action("EditBook", "Admin", new { id = b.Id })">Edit</a>
                    </td>
                    <td>                        
                        <form asp-action="DeleteBook" asp-controller="Admin" method="post">
                            <input type="hidden" name="id" value="@b.Id" />
                            <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this book?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
