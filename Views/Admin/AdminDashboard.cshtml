<section class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-black">Admin Dashboard</h1>
        <p class="fw-bold text-muted">
            Monitor users, books, and platform activity in real time.
        </p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card shadow-lg border-0 text-center p-4 h-100 dashboard-card float-card gradient-blue">
                <i class="bi bi-people-fill display-5 text-black mb-3"></i>
                <h6 class="fw-bold  dashboard-label text-black">Total Users</h6>
                <h2 class="fw-bold text-white">@ViewBag.TotalUsers</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 text-center p-4 h-100 dashboard-card float-card gradient-green">
                <i class="bi bi-book-fill display-4 text-black mb-3"></i>
                <h6 class="fw-bold  dashboard-label text-black">Total Books</h6>
                <h2 class="fw-bold text-white">@ViewBag.TotalBooks</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 text-center p-4 h-100 dashboard-card float-card gradient-orange">
                <i class="bi bi-cart-check-fill display-4 text-white mb-3"></i>
                <h6 class="fw-bold  dashboard-label text-black">Total Orders</h6>
                <h2 class="fw-bold text-white">@ViewBag.TotalOrders</h2>
            </div>
        </div>
    </div>
 
    <div class="row g-4 justify-content-center">
        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Users" class="text-decoration-none">
                <div class="card shadow-lg border-0 text-center p-4 h-100 dashboard-action action-blue">
                    <i class="bi bi-person-check-fill display-5 text-white mb-2"></i>
                    <p class="fw-bold mb-0 text-white">View All Users</p>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Books" class="text-decoration-none">
                <div class="card shadow-lg border-0 text-center p-4 h-100 dashboard-action action-green">
                    <i class="bi bi-journal-check display-5 text-white mb-2"></i>
                    <p class="fw-bold mb-0 text-white">Manage Books</p>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Reports" class="text-decoration-none">
                <div class="card shadow-lg border-0 text-center p-4 h-100 dashboard-action action-orange">
                    <i class="bi bi-graph-up display-5 text-white mb-2"></i>
                    <p class="fw-bold mb-0 text-white">View Reports</p>
                </div>
            </a>
        </div>


    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Index" class=" btn btn-outline-dark btn-lg">
            <i class="fw-bold bi bi-arrow-left"></i> Back to Home
        </a>
    </div>
</section>

<style>
    body {
        background: linear-gradient(to right, #fde7a5, #e6b9ae);
    }

    .float-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: default;
        border-radius: 15px;
    }
    .float-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    }

    .dashboard-action {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 15px;
    }
    .dashboard-action:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    .dashboard-label {
    font-size: 1.3rem; /* adjust as needed */
    }

  
    .gradient-blue { background: linear-gradient(135deg, #77bdfa, #fa98dd); }
    .gradient-green { background: linear-gradient(135deg, #7df98f, #7dfbe4); }
    .gradient-orange { background: linear-gradient(135deg, #fbdd7a, #f89c83); }

    .action-blue { background-color: #126ef8; }
    .action-green { background-color: #0f7d4a; }
    .action-orange { background-color: #fb790e; }
    .action-purple { background-color: #6b3fbd; }

    .dashboard-action p { font-size: 1.1rem; }
</style>
