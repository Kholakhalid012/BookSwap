<style>
    body {
        background: linear-gradient(to right, #fcf1cf, #fdccb7);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
        text-align: center;
        margin-top: 20px;
        margin-bottom: 30px;
        color: #6f42c1;
        font-weight: bold;
    }

    /* List group styling */
    .list-group {
        max-width: 600px;
        margin: 0 auto;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        background-color: #ffffffcc;
    }

    .list-group-item {
        font-size: 1.1rem;
        transition: transform 0.2s ease, background-color 0.2s ease;
        cursor: default;
    }

    .list-group-item:hover {
        background-color: #ffe6cc;
        transform: translateX(5px);
    }

    /* Form styling */
    form {
        max-width: 600px;
        margin: 30px auto 0 auto;
        display: flex;
        gap: 0;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        background-color: #fff;
    }

    .form-control {
        border: none;
        padding: 10px 15px;
        flex-grow: 1;
        font-size: 1rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #7f00ff, #e100ff);
        border: none;
        padding: 0 20px;
        font-weight: bold;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #e100ff, #7f00ff);
        transform: scale(1.05);
    }
</style>

<h2>Manage Categories</h2>

<ul class="list-group mt-3">
    @foreach (var c in Model)
    {
        <li class="list-group-item">@c</li>
    }
</ul>

<form asp-action="AddCategory" method="post" class="mt-4">
    <input type="text" name="categoryName" class="form-control" placeholder="New Category" required />
    <button class="btn btn-primary">Add</button>
</form>
